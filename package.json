{
  "name": "@library/typography-api",
  "version": "1.0.0",
  "description": "Typography Public API - Font metadata extraction and processing",
  "type": "module",
  "scripts": {
    "extract-metadata": "node scripts/extract-metadata.js",
    "normalize-names": "node scripts/normalize-names.js",
    "generate-subsets": "node scripts/generate-subsets.js",
    "convert-formats": "bash scripts/convert-to-web-formats.sh",
